# KhataFlow Production Environment Configuration

# Server Port (default: 5050 or provided by host)
PORT=5050

# Node Environment ('production' or 'development')
NODE_ENV=production

# Strong Secret Key for JWT token signing (REPLACE with your own 64-char random string in production!)
JWT_SECRET=khataflow_prod_secret_replace_this_with_a_secure_random_key_64_chars_min

# Set to true ONLY if you want to preload sample demo data on initial start
SEED_DEMO=false
